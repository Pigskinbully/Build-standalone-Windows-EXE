<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenTimerRecorder</AssemblyName>
    <RootNamespace>ScreenTimerRecorder</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/ffmpeg.exe" Condition="Exists('Assets/ffmpeg.exe')" LogicalName="ScreenTimerRecorder.ffmpeg.exe" />
  </ItemGroup>
</Project>
